# The API Gateway — the ONLY backend host the frontend may know about.
#
# Never add user-service:8001, order-service:8002, payment-service:8003 or any
# other internal service URL here. The browser talks to the gateway and nothing
# else; internal topology stays behind it.
#
# Use "localhost", not "127.0.0.1". The dev server is on localhost:5173, and a
# SameSite=Lax cookie is only sent when both origins share a *site*. Ports are
# not part of a site, so :5173 -> :8000 is fine; hosts are, so localhost ->
# 127.0.0.1 is cross-site and the browser would silently drop the session
# cookie on every request.
VITE_API_URL=http://localhost:8000

# How the session credential travels to the gateway.
#
#   cookie  — the backend sets an HttpOnly session cookie on login/register and
#             the browser attaches it automatically. The frontend stores
#             nothing, and no script can read the credential. This is the
#             default and what the backend now does.
#
#   bearer  — the token from the login/register response body is sent as
#             `Authorization: Bearer`. Held in memory only, never in
#             localStorage/sessionStorage, so it is discarded on reload. The
#             backend still accepts this form, which is what non-browser
#             clients use.
#
# Both modes send credentials (`withCredentials: true` is always on), so
# switching is this one variable — no application code changes.
VITE_AUTH_TRANSPORT=cookie

# NEVER put secrets here. Everything prefixed VITE_ is inlined into the client
# bundle at build time and is readable by anyone who opens the site.
