# Must be "localhost", not "127.0.0.1" — see .env.example. The dev server runs
# on localhost:5173, and a SameSite=Lax cookie is only sent when both origins
# share a site. Different ports are fine; different hosts are not.
VITE_API_URL=http://localhost:8000

VITE_AUTH_TRANSPORT=cookie

# ── Map ───────────────────────────────────────────────────────────────────
# The map offers three basemaps — street, light, dark. Light and dark are
# CARTO's, hard-coded in src/components/Map/tileStyles.ts because they are
# key-free and their attribution is licence-required.
#
# These two settings override the STREET style only: it is the slot a keyed
# provider (MapTiler/Stadia/Thunderforest — all this same URL shape) would take.
# The default is OpenStreetMap's own tile server: no key, no account, and a
# usage policy that asks for a real referrer and no bulk downloading — fine for
# an app this size, not for a heavily trafficked one.
#
# Tiles are the one resource the browser fetches directly rather than through
# the gateway. They are images: proxying them would add a hop to every one of
# the ~20 requests a single map view makes, and buy nothing.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Where a map opens when it has nothing else to go on — no saved address, no
# browser location. "lat,lng".
# VITE_MAP_DEFAULT_CENTER=12.971599,77.594566
